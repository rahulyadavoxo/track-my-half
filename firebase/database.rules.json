{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$deviceId": {
        ".read": "auth != null && auth.token.role == 'viewer' && auth.token.deviceId == $deviceId && data.child('requestId').val() == auth.token.requestId",
        ".write": "auth != null && auth.token.role == 'device' && auth.token.deviceId == $deviceId",
        ".validate": "!newData.exists() || newData.hasChildren(['requestId', 'lat', 'lng', 't'])"
      }
    },
    "trail": {
      "$requestId": {
        ".read": "auth != null && auth.token.role == 'viewer' && auth.token.requestId == $requestId",
        ".write": "auth != null && auth.token.role == 'device' && root.child('live').child(auth.token.deviceId).child('requestId').val() == $requestId",
        ".indexOn": ["t"]
      }
    }
  }
}
